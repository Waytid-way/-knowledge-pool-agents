{
  "$defs": {
    "KnowledgeStatus": {
      "enum": [
        "explicit",
        "derived",
        "inferred",
        "uncertain",
        "conflicted"
      ],
      "title": "KnowledgeStatus",
      "type": "string"
    },
    "PoolScope": {
      "enum": [
        "global",
        "organization",
        "domain",
        "project",
        "task"
      ],
      "title": "PoolScope",
      "type": "string"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "element_ids": {
          "items": {
            "type": "string"
          },
          "title": "Element Ids",
          "type": "array"
        },
        "pages": {
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "title": "Pages",
          "type": "array"
        }
      },
      "required": [
        "document_id",
        "pages"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "confidence": {
      "default": 1.0,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "content": {
      "additionalProperties": true,
      "title": "Content",
      "type": "object"
    },
    "object_id": {
      "minLength": 1,
      "title": "Object Id",
      "type": "string"
    },
    "object_type": {
      "minLength": 1,
      "title": "Object Type",
      "type": "string"
    },
    "pool_id": {
      "minLength": 1,
      "title": "Pool Id",
      "type": "string"
    },
    "project_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Id"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/PoolScope"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceRef"
      },
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/KnowledgeStatus"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "object_id",
    "object_type",
    "title",
    "pool_id",
    "scope",
    "status",
    "content",
    "sources"
  ],
  "title": "KnowledgeObject",
  "type": "object"
}
