{
  "$defs": {
    "WorkflowState": {
      "enum": [
        "document_registered",
        "profiled",
        "structure_mapped",
        "reading_units_created",
        "objects_extracted",
        "objects_normalized",
        "graph_built",
        "coverage_verified",
        "wiki_composed",
        "published",
        "needs_reprocessing",
        "needs_human_review",
        "failed",
        "quarantined"
      ],
      "title": "WorkflowState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attempt": {
      "default": 1,
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "current_state": {
      "$ref": "#/$defs/WorkflowState"
    },
    "document_id": {
      "minLength": 1,
      "title": "Document Id",
      "type": "string"
    },
    "pool_id": {
      "minLength": 1,
      "title": "Pool Id",
      "type": "string"
    },
    "requested_state": {
      "$ref": "#/$defs/WorkflowState"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "document_id",
    "pool_id",
    "current_state",
    "requested_state"
  ],
  "title": "WorkflowRun",
  "type": "object"
}
