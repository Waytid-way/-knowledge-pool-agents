{
  "$defs": {
    "DocumentStatus": {
      "enum": [
        "registered",
        "stored",
        "profiling",
        "profiled",
        "processing",
        "verified",
        "failed",
        "quarantined"
      ],
      "title": "DocumentStatus",
      "type": "string"
    },
    "ElementStatus": {
      "enum": [
        "discovered",
        "queued",
        "processing",
        "processed",
        "partially_processed",
        "verified",
        "needs_review",
        "failed"
      ],
      "title": "ElementStatus",
      "type": "string"
    },
    "PageElement": {
      "additionalProperties": false,
      "properties": {
        "element_id": {
          "minLength": 1,
          "title": "Element Id",
          "type": "string"
        },
        "element_type": {
          "minLength": 1,
          "title": "Element Type",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "status": {
          "$ref": "#/$defs/ElementStatus"
        }
      },
      "required": [
        "element_id",
        "element_type",
        "status"
      ],
      "title": "PageElement",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "document_id": {
      "minLength": 1,
      "title": "Document Id",
      "type": "string"
    },
    "document_status": {
      "$ref": "#/$defs/DocumentStatus"
    },
    "elements": {
      "items": {
        "$ref": "#/$defs/PageElement"
      },
      "title": "Elements",
      "type": "array"
    },
    "page_number": {
      "minimum": 1,
      "title": "Page Number",
      "type": "integer"
    },
    "reading_unit_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reading Unit Id"
    },
    "section_path": {
      "items": {
        "type": "string"
      },
      "title": "Section Path",
      "type": "array"
    }
  },
  "required": [
    "document_id",
    "page_number",
    "document_status"
  ],
  "title": "PageManifest",
  "type": "object"
}
