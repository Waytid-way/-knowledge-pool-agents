{
  "$defs": {
    "PoolScope": {
      "enum": [
        "global",
        "organization",
        "domain",
        "project",
        "task"
      ],
      "title": "PoolScope",
      "type": "string"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "element_ids": {
          "items": {
            "type": "string"
          },
          "title": "Element Ids",
          "type": "array"
        },
        "pages": {
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "title": "Pages",
          "type": "array"
        }
      },
      "required": [
        "document_id",
        "pages"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "answer_object_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Answer Object Ids",
      "type": "array"
    },
    "answerability": {
      "default": "fully_answerable",
      "title": "Answerability",
      "type": "string"
    },
    "pool_id": {
      "minLength": 1,
      "title": "Pool Id",
      "type": "string"
    },
    "project_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Id"
    },
    "question": {
      "minLength": 1,
      "title": "Question",
      "type": "string"
    },
    "question_id": {
      "minLength": 1,
      "title": "Question Id",
      "type": "string"
    },
    "question_type": {
      "minLength": 1,
      "title": "Question Type",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/PoolScope"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceRef"
      },
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "question_id",
    "question_type",
    "question",
    "pool_id",
    "scope",
    "answer_object_ids",
    "sources"
  ],
  "title": "QuestionObject",
  "type": "object"
}
